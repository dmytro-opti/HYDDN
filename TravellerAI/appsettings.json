{
  "ConnectionStrings": {
    "TravellerDb": "Server=localhost,1433;Database=TravellerAI;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "TravellerAI",
    "Audience": "TravellerAI.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}
